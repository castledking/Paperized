# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Generated output. The converter writes packs; they are build artifacts, not source.
# The one exception is the sample pack under tests/fixtures/, which is tracked so the
# tests have something stable to assert against.
out/
/pack/
*.pack.zip

# IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo
.windsurf/

# OS / editor junk
.DS_Store
Thumbs.db
*~

# Logs and interrupted atomic writes
*.log
*.tmp
*.tmp.*